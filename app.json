{
  "expo": {
    "name": "FlowChat",
    "slug": "chatapp-mobile",
    "scheme": "flowchat",
    "description": "FlowChat - Fast, modern real-time messaging with group chat pinning, voice notes, and seamless multi-device synchronization.",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.flowchat.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/161db668-a5e0-4a99-bde8-354e7a8704e8"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "161db668-a5e0-4a99-bde8-354e7a8704e8"
      }
    },
    "owner": "nas369s-team"
  }
}
